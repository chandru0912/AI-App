# Copy to .env and fill the required values.
NODE_ENV=development
PORT=4000

# Required. At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Production PostgreSQL connection string. Omit in development to use embedded PGlite.
# DATABASE_URL=postgres://user:password@host:5432/my_life_ai
PGLITE_DIR=.data/pglite

# Required for document scanning. 32 bytes as base64 or 64-char hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=

# Optional OpenAI-compatible provider. Without it the assistant uses the local Tamil/Tanglish/English parser.
# AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# Optional Google Places API (New) key for local services.
# GOOGLE_PLACES_API_KEY=

# Optional Expo push access token for server backup notifications.
# EXPO_ACCESS_TOKEN=

CORS_ORIGINS=http://localhost:8081,http://localhost:19006
AUTO_MIGRATE=true
SCHEDULER_ENABLED=true
UPLOAD_DIR=uploads
